bool qedResume(var obj) {
/$if (obj instanceof Array) {
    let size = obj.size();
    let oneItem = false;

    for (let index = 0; index < size; index++)
      oneItem |= this.qedResume(obj[index]);

    return oneItem;
  }
  else
    if (obj.blocking__Call)
      return this.qedResume(obj.blocking__Call)
    else
      if (obj.processFn) {
        obj.processFn();
        return true;
      }
      else
        return false;$/
}
