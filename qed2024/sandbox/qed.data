  bool equal = value1 == value2

/$  if (!equal && value1 instanceof Array && value2 instanceof Array) {
    equal = (value1.length == value2.length) && value1.every(function(element, index) {
        return Main_$this.qedEqual(element, value2[index]); 
    });
  }$/

  return equal
}
