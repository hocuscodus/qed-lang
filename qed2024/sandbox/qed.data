void ButtonContent(bool[] pressed) {<out:"";>}

void GenericButton(ButtonContent *ContentFn) {
  bool[] pressed = [false]
  ButtonContent content = new ContentFn(pressed)

  <out: content;
   onPress: {pressed[0] = true; _captureFocus();}
   onRelease: {pressed[0] = false; _releaseFocus(); return}
  >
}

String LinkButton(String text) {
  var button = new GenericButton((void L(bool[] pressed) {
    <out: text; opacity: pressed[0] ? 35% : 100%;>
  })) -> return text

  <out: button;>
}

void RectButton(VoidHandler_ *ContentFn) {
  VoidHandler_ content = new ContentFn()
  var button = new GenericButton((void L(bool[] pressed) {
    <out: roundRect;
      <out: rect; opacity: pressed[0] ? 35% : 0%; fillStyle: "black";>
      <out: content;>
    >
  })) -> return

  <out: button;>
}

String TextButton(String text) {
  var button = new RectButton((void L() {
    <\expand: 100%;
      <size: ((int) getAttribute(QED_TAG_FONTSIZE)) * 0.2; expand: 1;>
      <out: text; fillStyle: "white";>
      <size: ((int) getAttribute(QED_TAG_FONTSIZE)) * 0.2; expand: 1;>
    >
  })) -> return text

  <out: button;>
}

