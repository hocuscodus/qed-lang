void executeEvents_() {
/$while (postHandler != null)
    if (postHandler instanceof Array) {
      const obj = postHandler[0];
      const ret = postHandler[1];
    
      postHandler = null;

      if (obj._HandlerFn_)
        obj._HandlerFn_(ret);
    } else {
      const handler = postHandler;
    
      postHandler = null;
      handler();
    }

  _refresh(this.MainObj, 0, 0, canvas.width, canvas.height)$/
}
