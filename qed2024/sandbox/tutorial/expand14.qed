// Window scaling
float scaling = 0
float pos = 0
int start = -1
float speed = 50/1000 // 50% per 1000ms

while(true) { // Animation logic
  int end = Animation()
  float elapsedTimeMs = start == -1 ? 0 : end - start

  pos = (pos + elapsedTimeMs * speed) % 200
  scaling = (pos < 100 ? pos : 200 - pos)%
  start = end
}

// Window UI
<out: rect; size:[600, 800]; color: 0xC0FFEE;
  <size:[300, 100]; pos: 10; expand: scaling * 80%;
  <| out: rect; color: 0x0090C0
    // title
    <out: "My Window"; color: 0xFFFFFF; align: 50%;>
    // client rect
    <\ expand: 100%;
      <size: [5, 0];>
      <_ expand: 100%; out: rect; color: 0x808080;
        <out: rect; size: [60, 0]; color: 0xD0D0D0; expand: [20%, 100%];>
        <size: 5;>
        <| expand: [80%, 100%];
          <out: rect; color: 0xF0F0F0; expand: 100%;>
          <size: 5;>
          <_ align: 100%; color: 0x40C040;
            <out: rect; size: [40, 20];>
            <size: 10;>
            <out: rect; size: [40, 20];>
          >
        >
      >
      <size: 5;>
    >
  >
  >
>
