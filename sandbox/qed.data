int QedKeyEvent() {
  int keyCode
  QedYield trigger

  void waitUserTrigger_() {
    trigger = new QedYield() -> {
      /$this.waitUserTrigger_()$/
      return keyCode
    }
  }

  void fetchKeyCode(int code) {
    keyCode = code
    qedResume(trigger)
  }

  /$canvas.tabIndex = 1;
  canvas.onkeydown = function keyDown(e) {
    this.fetchKeyCode(e.keyCode);
  }.bind(this)$/
  waitUserTrigger_()
}
