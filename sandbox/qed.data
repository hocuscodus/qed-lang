var SQEDArray(InitFn *Init, int numDim, int[] dirs, Qui_ *Ui_) {
  /$this.dims = new Array(numDim).fill(0)$/

  int size() {
    int s = 1

    for (int index = /$this.dims.length - 1$/; index >= 0; index--)
      s *= /$this.dims[index]$/

    return s
  }

  var insert(int[] pos, int[] size) {
    // runtime error
    return /$null$/
  }

  var Insert(int[] pos, int[] size) {
    int[] newSize = /$[...this.size]$/

    for (int index = /$this.SQEDArray$this.dims.length - 1$/; index >= 0; index--)
      newSize[index] += /$this.SQEDArray$this.dims[index]$/

    InsertLevel(/$this.SQEDArray$this$/, /$this.SQEDArray$this.dims$/, pos, size, newSize, /$new Array(this.size.length).fill(0)$/, 0)
    /$this.SQEDArray$this.dims$/ = newSize
    return /$this.SQEDArray$this$/
  }

  var remove(int[] pos, int[] size) {
    int[] newSize = /$[...this.dims]$/

    for (int index = /$this.dims.length - 1$/; index >= 0; index--)
      newSize[index] -= /$size[index]$/

    removeLevel(/$this$/, /$this.dims$/, pos, size, newSize, /$new Array(size.length).fill(0)$/, 0)
    /$this.dims$/ = newSize
    return /$this$/
  }

  void InsertLevel(var[] array, int[] dims, int[] pos, int[] size, int[] newSize, int[] pp, int level) {
    if (level < /$this.SQEDArray$this.dims.length - 1$/) {
      for (pp[level] = 0; pp[level] < pos[level]; pp[level]++)
        InsertLevel(array[pp[level]], dims, pos, size, newSize, pp, level + 1)

      if (size[level] != 0)
        for (pp[level] = dims[level] - 1; pp[level] >= pos[level]; pp[level]--)
          array[pp[level] + size[level]] = array[pp[level]]

      for (pp[level] = pos[level]; pp[level] < pos[level] + size[level]; pp[level]++) {
        array[pp[level]] = /$[]$/
        InsertLevel(array[pp[level]], /$new Array(this.size.length).fill(0)$/, /$new Array(this.size.length).fill(0)$/, newSize, newSize, pp, level + 1)
      }

      for (pp[level] = pos[level] + size[level]; pp[level] < newSize[level]; pp[level]++)
        InsertLevel(array[pp[level]], dims, pos, size, newSize, pp, level + 1)
    }
    else {
      if (size[level] != 0)
        for (pp[level] = dims[level] - 1; pp[level] >= pos[level]; pp[level]--)
          array[pp[level] + size[level]] = array[pp[level]]

      for (pp[level] = pos[level]; pp[level] < pos[level] + size[level]; pp[level]++)
        array[pp[level]] = Init(pp)
    }
    return;
  }

  void removeLevel(var[] array, int[] dims, int[] pos, int[] size, int[] newSize, int[] pp, int level) {
    if (level < /$this.SQEDArray$this.dims.length - 1$/) {
      for (pp[level] = dims[level] - 1; pp[level] >= pos[level] + size[level]; pp[level]--)
        removeLevel(array[pp[level]], dims, pos, size, newSize, pp, level + 1)

      if (size[level] != 0)
        for (pp[level] = pos[level]; pp[level] < newSize[level]; pp[level]++)
          array[pp[level]] = array[pp[level] + size[level]]

      for (pp[level] = pos[level] - 1; pp[level] >= 0; pp[level]--)
        removeLevel(array[pp[level]], dims, pos, size, newSize, pp, level + 1)
    }
    else
      if (size[level] != 0)
        for (pp[level] = pos[level]; pp[level] < newSize[level]; pp[level]++)
          array[pp[level]] = array[pp[level] + size[level]]

    return;
  }

  var push() {
    // runtime error
    return /$null$/
  }

  var Push() {
    int[] pos = /$new Array(this.SQEDArray$this.dims.length).fill(0)$/
    int[] size = /$new Array(this.SQEDArray$this.dims.length).fill(0)$/

    pos[0] = /$this.SQEDArray$this.dims[0]$/
    size[0] = 1
    Insert(pos, size)
    return /$this.SQEDArray$this$/
  }

  var pop() {
    int[] pos = /$new Array(this.dims.length).fill(0)$/
    int[] size = /$new Array(this.dims.length).fill(0)$/

    pos[0] = /$this.dims[0] - 1$/
    size[0] = 1
    remove(pos, size)
    return /$this$/
  }
}

