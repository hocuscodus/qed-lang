    for (int index = /$this.VSQEDArray$this.dims.length - 1$/; index >= 0; index--)
      newSize[index] += /$this.VSQEDArray$this.dims[index]$/;

    InsertLevel(/$this.VSQEDArray$this.dims$/, pos, size, newSize, /$new Array(this.size.length).fill(0)$/, 0)
    /$this.VSQEDArray$this.dims$/ = newSize
    return /$this$/
  }

  void InsertLevel(var dims, int[] pos, int[] size, int[] newSize, var pp, int level) {
    if (level < /$this.VSQEDArray$this.dims.length - 1$/) {
      for (/$this.pp[this.level] = 0$/; /$this.pp[this.level] < this.pos[this.level]$/; /$this.pp[this.level]++$/)
        InsertLevel(dims, pos, size, newSize, pp, level + 1)

      for (/$this.pp[this.level] = this.pos[this.level]$/; /$this.pp[this.level] < this.pos[this.level] + this.size[this.level]$/; /$this.pp[this.level]++$/) {
        /$array[this.pp[this.level]] = []$/
        InsertLevel(/$new Array(this.size.length).fill(0)$/, /$new Array(this.size.length).fill(0)$/, newSize, newSize, pp, level + 1)
      }

      for (/$this.pp[this.level] = this.pos[this.level] + this.size[this.level]$/; /$this.pp[this.level] < this.newSize[this.level]$/; /$this.pp[this.level]++$/)
        InsertLevel(dims, pos, size, newSize, pp, level + 1)
    }
    else
      for (/$this.pp[this.level] = this.pos[this.level]$/; /$this.pp[this.level] < this.pos[this.level] + this.size[this.level]$/; /$this.pp[this.level]++$/)
        Init(pp)

    return;
  }
}

