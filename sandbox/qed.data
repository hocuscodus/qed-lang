void ViewArray_(QEDBaseArray_[] array, int[] dirs, resizeView *resizeViewFn, paintView *paintViewFn, onViewEvent *onViewEventFn, getViewElementRect *getViewElementRectFn) {
  float[][] posSet = /$[]$/
  float[] size = [0, 0]

  void recalcLayout() {
    int length = array.size()
    float space = /$_spacing$/

    for (int index = 0; index < length; index++) {
      float[] elementSize = resizeViewFn(array[index])

      posSet[index] = [0, 0]

      for (int dir = 0; dir < 2; dir++) {
        posSet[index][dir] = dirs[dir] ? (index ? size[dir] + space : 0) + elementSize[dir] : max(size[dir], elementSize[dir]);
        size[dir] = posSet[index][dir];
      }
    }
  }

  void paint(float pos0, float pos1, float size0, float size1, bool fast) {
    int length = array.size()
    float space = /$_spacing$/
    float[] newPos = [pos0, pos1]
    float[] pos = [pos0, pos1]
    float[] size = [size0, size1]

    for (int index = 0; index < length; index++) {
      for (int dir = 0; dir < 2; dir++)
        if (dirs[dir]) {
          float relPos = index ? posSet[index - 1][dir] + space : 0

          pos[dir] = newPos[dir] + relPos
          size[dir] = posSet[index][dir] - relPos
        }

      paintViewFn(array[index], pos[0], pos[1], size[0], size[1], fast)
    }
  }

  bool onEvent(int event, float pos0, float pos1, float size0, float size1) {
    int length = array.size()
    float space = /$_spacing$/
    float[] pos = [0, 0];
    float[] size = [size0, size1];

    for (int index = length - 1; index >= 0; index--) {
      for (int dir = 0; dir < 2; dir++)
        if (dirs[dir]) {
          pos[dir] = index ? posSet[index - 1][dir] + space : 0
          size[dir] = posSet[index][dir] - pos[dir]
        }

      if (pos0 >= pos[0] && pos0 < pos[0] + size[0] && pos1 >= pos[1] && pos1 < pos[1] + size[1]) {
        pos0 -= pos[0]
        pos1 -= pos[1]

        return onViewEventFn(array[index], event, pos0, pos1, size[0], size[1])
      }
    }

    return false
  }

  float[] getBoundsRect(String[] path, int[] index, float pos0, float pos1, float size0, float size1, int level, int dLevel) {
    float space = /$_spacing$/
    int ndx = index[0]
    float relPos = ndx ? posSet[ndx - 1][0] + space : 0
    float posx = pos0 + relPos
    float posy = pos1
    float sizex = posSet[ndx][0] - relPos
    float sizey = size1

    dLevel++
    if (level < path.size() || dLevel < index.size())
      return getViewElementRectFn(array[ndx], path, index, posx, posy, sizex, sizey, level, dLevel)
    else
      return [posx, posy, sizex, sizey]
  }
}

