bool qedEqual(var value1, var value2) {
  bool equal = value1 == value2

  if (!equal && /$value1 instanceof Array && value2 instanceof Array$/) {
    bool fn(var element, int index) {
      return qedEqual(element, /$value2[index]$/);
    }
    equal = /$value1.length == value2.length && value1.every(fn)$/
  }

  return equal
}
void rotate(float x, float y, float width, float height, float angle) {
/$ctx.save()$/
/$ctx.translate(x + width / 2, y + height / 2)$/
/$ctx.rotate(angle)$/
}
