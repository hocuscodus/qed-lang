// Try this demo as is (alignment fully applies),
// then with the next line as "<_" (vertical alignment
// only), "<|" (horizontal alignment only) and "<\"
// (no alignment applies)
<
  <out: rect; fillStyle: "red"; size: 60;>
  <out: rect; fillStyle: "Lime"; size: 40; align: 50%;>
  <out: rect; fillStyle: "blue"; size: 20; align: 100%;>
>