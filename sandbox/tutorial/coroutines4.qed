QedYield cancelHandler

bool CountToTen() {
  cancelHandler = new QedYield() -> return false

  count::10 {
    QedTimer(1000)
    println("" + (count + 1))
  }

  return true;
}

new QedTimer(5500) -> qedResume(cancelHandler)
println("Starting count up to 10")
println("Count " + (CountToTen() ? "done" : "cancelled."))
