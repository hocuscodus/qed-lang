int popupCount = 1

void Popup(String title, String question, int col) {
  var yesButton = new TextButton("Yes") ->
    Popup("Popup " + popupCount++, "One more popup?", (int) (rand() * 0xFFFFFF))
  var noButton = new TextButton("No") -> return

  <| out: roundRect; color: col | 0x808080; radius: 10;
    <out: rect; color: 0x0090C0;
      <|
        <size: 10;>
        <out: title; color: 0xFFFFFF;
         align: 50%;>
        <size: 5;>
      >
    >
    <\ color: 0x000000; fontSize: 17;
      <size: [30, 20];>
      <out: question; align: 50%; >
      <size: 30;>
    >
    <_ align: 100%; pos: -10; radius: 5;
      <out: yesButton; color: 0x40C040;>
      <size: 10;>
      <out: noButton; color: 0xC04040;>
    >
  >
}

Popup("Popup " + popupCount++, "Another popup?", (int) (rand() * 0xFFFFFF))
return 0 // Exit app with code 0
