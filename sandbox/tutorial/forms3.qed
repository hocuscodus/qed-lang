int popupCount = 1

void Popup(String title, String question, String exitLabel, int margin) {
  var yesButton = new TextButton("Yes") ->
    Popup("Popup " + popupCount++, "One more?", "No", max(margin - 10, 0))
  var noButton = new TextButton(exitLabel) -> return

  <out: rect; color: 0; opacity: 40%;> // black veil behind
  <|out: roundRect; color: 0xE0E0E0; radius: 9; align: 50%;
    <\out: rect; color: 0x0090C0;
      <size: 10;>
      <out: title; color: 0xFFFFFF;>
      <size: 5;>
    >
    <\ color: 0x000000; fontSize: 17;
      <size: [30 + margin, 20 + margin];>
      <out: question;>
      <size: 30 + margin;>
    >
    <_ align: 100%; pos: -10; radius: 5;
      <out: yesButton; color: 0x40C040;>
      <size: 10;>
      <out: noButton; color: 0xC04040;>
    >
  >
}

Popup("Window", "Create popup?", "Exit", 50)
return 0
